# Public browser configuration.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Stripe Payment Links are public URLs. This CTA is compiled into the web app
# and is hidden at runtime in the iOS and Android builds.
VITE_STRIPE_ACADEMY_PAYMENT_LINK=https://buy.stripe.com/YOUR_PAYMENT_LINK

# Server-only secrets. Set with `supabase secrets set`; never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
GHL_PRIVATE_INTEGRATION_TOKEN=YOUR_SCOPED_PRIVATE_INTEGRATION_TOKEN
GHL_LOCATION_ID=YOUR_LOCATION_ID

# Optional paid membership. Keep both values server-side.
APP_URL=https://app.dirtyturf.com
# Keep the Netlify origin during the controlled pilot. Remove it after the
# custom domain is live and the production smoke test passes.
APP_ALLOWED_ORIGINS=https://app.dirtyturf.com,https://bright-brigadeiros-df8b48.netlify.app
AUTH_REDIRECT_URLS=https://bright-brigadeiros-df8b48.netlify.app,https://app.dirtyturf.com/mobile-auth-callback.html,com.dirtyturf.academy://auth/callback
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# Transactional Academy/community email. These belong only in Supabase Edge
# Function secrets. Auth Magic Links use the separate Supabase SMTP settings.
MAILGUN_API_KEY=YOUR_MAILGUN_API_KEY
MAILGUN_DOMAIN=YOUR_VERIFIED_MAILGUN_DOMAIN
MAILGUN_FROM_EMAIL=YOUR_VERIFIED_SENDER
MAILGUN_FROM_NAME=Dirty Turf Academy
MAILGUN_REGION=us
NOTIFICATION_DISPATCH_SECRET=GENERATE_A_LONG_RANDOM_VALUE
NOTIFICATION_SIGNING_SECRET=GENERATE_A_DIFFERENT_LONG_RANDOM_VALUE
