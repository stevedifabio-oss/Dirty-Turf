# Server-only template. Copy to .env.stripe.local at the repository root.
# .env.stripe.local is ignored by Git. Never fill real values into this example.
# Use a local/staging Supabase project with Stripe sandbox credentials first.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=YOUR_TEST_SERVER_API_KEY
STRIPE_WEBHOOK_SECRET=YOUR_TEST_ENDPOINT_SIGNING_SECRET

# Exact web application origin for the matching backend environment.
# Production will use https://app.dirtyturf.com after verification.
APP_URL=http://localhost:5173
APP_ALLOWED_ORIGINS=http://localhost:5173

# Price IDs are saved in Academy billing-plan records, not in browser secrets.
# Test/live keys, Price IDs and webhook destinations must match.
# No VITE_STRIPE_SECRET_KEY or publishable Stripe key is required.
